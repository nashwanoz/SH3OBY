<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android">
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"> <!-- استخدام ScrollView لضمان ظهور كل العناصر على الشاشات الصغيرة دون اختفاء -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- 1. اسم السوبر ماركت (بخط كبير وعريض) -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الشعوبي ماركت"
            android:textSize="32sp" 
            android:textStyle="bold"
            android:textColor="#1A237E" 
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <!-- 2. الشعار اللفظي (بخط أصغر) -->
        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متعة التسوق"
            android:textSize="18sp"
            android:textColor="#757575"
            android:layout_marginBottom="24dp" />

        <!-- 3. عنوان شريط الصور المتحرك -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جديد الأصناف"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_gravity="right"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp" />

        <!-- 4. شريط الصور المتحرك (مؤقتاً صورة واحدة ثابتة بحجم مناسب) -->
        <ImageView
            android:id="@+id/imageSlider"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- 5. مربع البحث -->
        <EditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="ابحث عن صنف أو منتج..."
            android:inputType="text"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="24dp" />

        <!-- 6. عنوان الأقسام الرئيسي -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أقسام المواد الغذائية"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_gravity="right"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="16dp" />

        <!-- (هنا مساحة فارغة مخصصة مستقبلاً لعرض الأقسام أو الأصناف الفعليّة) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 7. قسم الدفع المنسق -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نقبل الدفع عبر تطبيق جوالي وتطبيق جيب"
                android:textSize="14sp"
                android:textColor="#424242"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- أيقونة تطبيق جيب -->
                <ImageView
                    android:id="@+id/imgJaib"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/jaib" /> <!-- تأكد من تحويل الاسم لسمول عند وضعه في المجلد -->

                <!-- أيقونة تطبيق جوالي -->
                <ImageView
                    android:id="@+id/imgJawali"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/jawali" /> <!-- تأكد من تحويل الاسم لسمول عند وضعه في المجلد -->

            </LinearLayout>
        </LinearLayout>

        <!-- 8. الحقوق في أسفل الشاشة تماماً -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جميع الحقوق محفوظة\nsmart link"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
